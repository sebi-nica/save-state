# Copy to backend/.env and fill in. Never commit the real .env.
DEBUG=True
# Generate with: .venv/Scripts/python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
# Neon "dev" branch pooled connection string. Leave empty to use local SQLite.
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Twitch developer app (https://dev.twitch.tv/console)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Used by `manage.py ensure_superuser` (runs on every Render deploy)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
